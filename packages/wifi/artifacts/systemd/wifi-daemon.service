[Unit]
Description=WiFi manager daemon (Ioniq 5 Gen5W)
# multi-user.target keeps the radio work out of the boot transaction: the boot
# used to wait for the interface wait-loop below, which is why adding packages
# made the unit feel slow to start.
After=multi-user.target Dbuslaunch.service connman.service
Wants=connman.service
ConditionPathExists=/rw_data/wifi/wifi_daemon

[Service]
Type=simple
UMask=0077
RuntimeDirectory=wpa_supplicant
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Environment=PATH=/bin:/sbin:/usr/bin:/usr/sbin
# modprobe is idempotent and the firmware download is ~0.5 s, so wlan0 is
# normally up within seconds.  The wait is bounded to 20 s and always succeeds,
# so a slow or absent radio cannot hold the start job; the daemon retries on its
# own (Restart=always with the backoff below).
ExecStartPre=/sbin/modprobe bcmdhd
ExecStartPre=/bin/sh -c 'i=0; while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 20 ]; do sleep 2; i=$((i+2)); done; exit 0'
ExecStart=/bin/sh -c 'exec /rw_data/wifi/wifi_daemon --port 8090 --status-file /rw_data/wifi/status.json >> /rw_data/wifi/daemon.log 2>&1'
Restart=always
RestartSec=15
TimeoutStopSec=25
# Background work: never compete with the UI for CPU/IO during startup.
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10

[Install]
WantedBy=multi-user.target
