[Unit]
Description=Tweaks night-mode / Reboot daemon (Ioniq 5 Gen5W)
ConditionPathExists=/rw_data/tweaks/tweaks_daemon

[Service]
Type=simple
Environment=PATH=/bin:/sbin:/usr/bin:/usr/sbin
# wrandr is a Wayland client; the vendor session runs with this runtime dir.
Environment=XDG_RUNTIME_DIR=/var/run/user/root
# No "exec": with exec the shell is replaced, so a daemon that exits leaves no
# trace at all - which is exactly what happened on 2026-11-22 (ExecMainStatus=4,
# empty daemon.log, dead Tweaks page). Now every attempt records its own exit code
# and whatever it printed before leaving.
ExecStart=/bin/sh -c '/rw_data/tweaks/tweaks_daemon --port 8091 >> /rw_data/tweaks/daemon.log 2>&1; rc=$?; echo "daemon exit=$rc at $(date -u 2>/dev/null)" >> /rw_data/tweaks/daemon.log; exit $rc'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
